# Kindling settings. Copy to .env (ignored by git) and edit; real environment variables win over this file.
# Every setting is KINDLING_<NAME>. The values below are the defaults unless a comment says otherwise.
# Never commit real keys or secrets.

# --- models ---------------------------------------------------------------------------------
# A models.toml lists the models this server offers (cp models.example.toml models.toml).
# Without one, a single Ollama model is built from KINDLING_MODEL / KINDLING_NUM_CTX / KINDLING_OLLAMA_HOST.
KINDLING_MODELS_FILE=models.toml
KINDLING_MODEL=nemotron-3-nano:30b
# Unset: the Ollama client's default (OLLAMA_HOST, else http://localhost:11434). Compose sets it for the container.
# KINDLING_OLLAMA_HOST=http://localhost:11434
# Context window to ask Ollama for. Keep it equal to OLLAMA_CONTEXT_LENGTH, or Ollama reloads the model.
KINDLING_NUM_CTX=16384
# Added as the system message to every chat. Empty: none.
KINDLING_SYSTEM_PROMPT=

# --- storage --------------------------------------------------------------------------------
# postgres for real use; memory keeps nothing across restarts (tests, quick tries).
KINDLING_STORE=postgres
# The compose `db` service on port 5433. Inside compose, the app service overrides this with db:5432.
KINDLING_DATABASE_URL=postgresql+asyncpg://kindling:kindling@localhost:5433/kindling

# --- tools ----------------------------------------------------------------------------------
KINDLING_TOOLS_ENABLED=true
# Model turns per request before the agent loop gives up.
KINDLING_MAX_TOOL_STEPS=8
# The only folder the file tools can read.
KINDLING_WORKSPACE=workspace

# --- auth -----------------------------------------------------------------------------------
# Leave false. true lets anyone who can reach the server use it (a tunnel to 127.0.0.1 counts).
KINDLING_AUTH_DISABLED=false
# Bootstrap admin key, for first setup and CI. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Create real per-use-case keys with it, then remove it. Empty: no bootstrap key.
KINDLING_API_KEY=
# Default requests per minute per key; a key can override it.
KINDLING_RATE_LIMIT_PER_MINUTE=60

# --- ops ------------------------------------------------------------------------------------
# 127.0.0.1 keeps the server off the network; cloudflared on this machine still reaches it.
KINDLING_HOST=127.0.0.1
KINDLING_PORT=8000
# text for reading in a terminal, json for a log shipper.
KINDLING_LOG_FORMAT=text
KINDLING_LOG_LEVEL=INFO
# Browser origins allowed to call the API directly, as a JSON list, e.g. ["https://chat.example.com"].
# Empty: no CORS headers at all (server-to-server callers don't need them).
KINDLING_CORS_ORIGINS=[]
# Larger request bodies get 413.
KINDLING_MAX_REQUEST_BYTES=2000000
# Model streams running at once, across every model. Match OLLAMA_NUM_PARALLEL.
KINDLING_MAX_CONCURRENT_GENERATIONS=2
# Streams allowed to wait for a slot; beyond this, requests get 503 (529 on the Anthropic API) at once.
KINDLING_MAX_QUEUED_GENERATIONS=16
# How long a stream may wait for a slot before it gets 503.
KINDLING_QUEUE_TIMEOUT_SECONDS=60
# GET /metrics for Prometheus; needs an admin key unless auth is disabled.
KINDLING_METRICS_ENABLED=true
# Serve /docs and /openapi.json. Off by default: they map every route for anyone who can reach the server.
# KINDLING_API_DOCS=false

# --- edge (Cloudflare; see docs/cloudflare.md) ----------------------------------------------
# Take the client IP from CF-Connecting-IP. Only true when every request comes through Cloudflare.
KINDLING_TRUST_CLOUDFLARE_HEADERS=false
# If set, requests must carry it in the header below; only the edge knows it. Generate like the API key.
KINDLING_ORIGIN_SECRET=
KINDLING_ORIGIN_SECRET_HEADER=X-Kindling-Origin-Secret

# --- evals ----------------------------------------------------------------------------------
KINDLING_EVAL_RESULTS_DIR=evals/results
