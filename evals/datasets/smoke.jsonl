# Smoke test: a quick look at tools, reasoning, instruction following and output format.
# Run: kindling eval run smoke   (cases tagged "fixtures" read evals/fixtures and are skipped on --target http)
{"id": "calc-multiply", "tags": ["tools", "arithmetic"], "prompt": "What is 4817 * 2963? Use the calculator.", "expect": [{"tool_called": "calculate"}, {"number": 14272771}]}
{"id": "calc-percent", "tags": ["tools", "arithmetic"], "prompt": "What is 17.5% of 2,480? Use the calculator, then give the number.", "expect": [{"tool_called": "calculate"}, {"number": 434, "tolerance": 0.001}]}
{"id": "current-year", "tags": ["tools"], "prompt": "What year is it right now? Check the clock rather than guessing.", "expect": [{"tool_called": "current_time"}, {"regex": "\\b20\\d\\d\\b"}]}
{"id": "list-workspace", "tags": ["tools", "fixtures"], "prompt": "Which files are in my workspace?", "expect": [{"tool_called": "list_files"}, {"contains": ["inventory.csv", "project-notes.md"]}]}
{"id": "read-codename", "tags": ["tools", "fixtures"], "prompt": "Read project-notes.md in my workspace and tell me the project's codename.", "expect": [{"tool_called": "read_file", "arguments": {"path": "project-notes.md"}}, {"contains": "blue heron"}]}
{"id": "bat-and-ball", "tags": ["reasoning"], "tools": false, "prompt": "A bat and a ball cost $1.10 in total. The bat costs $1.00 more than the ball. How much does the ball cost, in dollars? End your reply with a line of the form `ANSWER: <number>`.", "expect": [{"number": 0.05, "tolerance": 0.001}]}
{"id": "shop-change", "tags": ["reasoning", "arithmetic"], "tools": false, "prompt": "Pens cost $3 each and notebooks $7 each. Maya buys 4 pens and 3 notebooks and pays with a $50 note. How much change does she get, in dollars? End your reply with a line of the form `ANSWER: <number>`.", "expect": [{"number": 17}]}
{"id": "one-word-colour", "tags": ["instructions"], "prompt": "What colour is a clear daytime sky? Answer with one word only.", "expect": [{"exact": "blue"}]}
{"id": "yes-no-prime", "tags": ["instructions"], "tools": false, "prompt": "Is 17 a prime number? Answer with only yes or no.", "expect": [{"exact": "yes"}]}
{"id": "reply-ok", "tags": ["instructions"], "prompt": "Reply with exactly the word OK and nothing else.", "expect": [{"exact": "ok"}, {"no_tool_calls": true}]}
{"id": "json-book", "tags": ["format"], "tools": false, "prompt": "Describe the novel Pride and Prejudice as a JSON object with the keys title (string), author (string) and year (integer, first published). Reply with the JSON only, no prose.", "expect": [{"json": true, "required": ["title", "author", "year"], "schema": {"type": "object", "properties": {"title": {"type": "string"}, "author": {"type": "string"}, "year": {"type": "integer"}}}}, {"contains": "austen"}, {"regex": "1813"}]}
{"id": "capital-australia", "tags": ["facts"], "prompt": "What is the capital city of Australia?", "expect": [{"contains": "canberra"}, {"max_output_tokens": 4000}]}
{"id": "summary-library", "tags": ["summary"], "tools": false, "prompt": "Summarise this in one sentence of at most 40 words:\n\nThe town council of Easton voted on Tuesday to close the old library on Mill Street and open a new one in the former railway station. The move will cost two million pounds and is due to finish in 2027. Some residents raised concerns about parking near the station.", "expect": [{"contains": ["library", "station"]}, {"contains": ["2027", "two million", "£2"], "mode": "any"}, {"regex": "^\\s*(?:\\S+\\s+){0,44}\\S+\\s*$"}]}
